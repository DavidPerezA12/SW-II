{
  "name": "api-videogames",
  "version": "1.0.0",
  "description": "REST API de videojuegos con MongoDB, JSON y XML",
  "main": "app.js",

  "scripts": {
    "start": "node ./bin/www",

    "seed:games": "node ./seeds/games",
    "seed:developers": "node ./seeds/developers",
    "seed:countries": "node ./seeds/countries",
    "seed:reviews": "node ./seeds/reviews",

    "seed": "npm run seed:games && npm run seed:developers && npm run seed:countries && npm run seed:reviews",

    "test": "echo \"No tests configured\""
  },

  "keywords": [
    "api",
    "rest",
    "videogames",
    "mongodb",
    "express",
    "xml",
    "json"
  ],

  "author": "Álvaro Sanz Cortés, Marcos Martínez Baeza, David Perez Alonso ",

  "license": "ISC",

  "dependencies": {
    "cookie-parser": "1.4.7",
    "ejs": "3.1.9",
    "express": "5.2.1",
    "mongodb": "^6.6.2",
    "morgan": "1.10.0",
    "xml2js": "^0.4.23"
  },

  "devDependencies": {
    "nodemon": "^3.1.0",
    "eslint": "^9.2.0"
  },

  "engines": {
    "node": ">=18"
  }
}